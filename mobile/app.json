{
  "expo": {
    "name": "FITLY",
    "slug": "fitly",
    "version": "1.0.0",
    "orientation": "portrait",
    "hostUri": "localhost:8081",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6C63FF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitly.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C63FF"
      },
      "package": "com.fitly.app"
    },
    "plugins": ["expo-router"],
    "scheme": "fitly",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://8081-01kjh74m2g3yb6f947rwt1axry.cloudspaces.litng.ai",
        "headOrigin": "https://8081-01kjh74m2g3yb6f947rwt1axry.cloudspaces.litng.ai"
      }
    }
  }
}
